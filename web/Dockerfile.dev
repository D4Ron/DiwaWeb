# syntax=docker/dockerfile:1
#
# Development image — source is bind-mounted from the host by compose, so this
# stage only needs the dependencies and the dev server.

FROM node:24-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci

COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
EXPOSE 3000

CMD ["npm", "run", "dev"]
