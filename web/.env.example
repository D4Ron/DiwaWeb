# Copy to .env.local for local development, and set the same names in the
# hosting platform for the deployed site.
#
# .env.local is gitignored. Never commit a real secret. Whoever operates the
# deployment owns these values — they should not be shared in chat, tickets
# or commits.
#
# The provider is chosen automatically in src/lib/mailer.ts:
#   Entra/Graph vars present -> Microsoft Graph
#   RESEND_API_KEY present   -> Resend
#   neither                  -> logged to the console, reported as undelivered

# ===========================================================================
# Option A — Microsoft Graph (preferred: the org already runs Entra ID)
# ===========================================================================
# Mail leaves from a real mailbox in your own tenant. No third party, no
# domain to verify, and with federated credentials no stored secret.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=

# The mailbox messages are sent from. Must exist in the tenant, and must be
# the mailbox the app registration is scoped to (see README).
GRAPH_SENDER=site@diwaindustries.tg

# Only needed if you are NOT using a federated credential. On Vercel, prefer
# OIDC federation (VERCEL_OIDC_TOKEN is supplied automatically at runtime).
# On Azure compute, prefer a managed identity. Both avoid this entirely.
AZURE_CLIENT_SECRET=

# ===========================================================================
# Option B — Resend (only if deploying outside the Entra tenant)
# ===========================================================================
# RESEND_API_KEY=
#
# Resend will only send from a domain verified in the Resend account. Until
# diwaindustries.tg is verified there, the built-in onboarding@resend.dev
# sender delivers only to the account owner's own address.
# CONTACT_FROM=Diwa Industries <site@diwaindustries.tg>

# ===========================================================================
# Recipients (both providers)
# ===========================================================================
CONTACT_TO=info@diwaindustries.tg

# Job applications. Falls back to CONTACT_TO, then info@diwaindustries.tg.
CAREERS_TO=info@diwaindustries.tg
