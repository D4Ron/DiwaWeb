# Copy to .env.local for local development, and set the same names in
# Vercel under Settings -> Environment Variables for the deployed site.
#
# .env.local is gitignored. Never commit a real key.

# --- Email delivery -------------------------------------------------------
# Without this, both form endpoints still return success and log the
# submission to the server console instead of sending. That is deliberate so
# the forms work on preview deployments with no credentials.
#
# Get a key at https://resend.com -> API Keys. It starts with "re_".
RESEND_API_KEY=

# Where the contact form delivers. Defaults to info@diwa.tg.
CONTACT_TO=info@diwa.tg

# Where job applications deliver. Falls back to CONTACT_TO, then info@diwa.tg.
CAREERS_TO=info@diwa.tg

# The From address. IMPORTANT: Resend only accepts a From address on a domain
# you have verified in your Resend account. Until diwaindustries.tg is
# verified there, the built-in default (onboarding@resend.dev) will only
# deliver to the email address that owns the Resend account — it will not
# reach info@diwa.tg.
#
# Once the domain is verified, set this to something like:
#   CONTACT_FROM=Diwa Industries <site@diwaindustries.tg>
CONTACT_FROM=
